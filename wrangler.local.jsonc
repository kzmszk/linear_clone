{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linc-local",
  "main": "apps/worker/src/local.ts",
  "compatibility_date": "2026-09-21",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRACKER",
        "class_name": "Tracker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Tracker"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "linc-files",
    },
  ],
  "vars": {
    "BOOTSTRAP_OWNER_EMAIL": "owner@example.test",
  },
}
