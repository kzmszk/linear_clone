{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linc",
  "account_id": "33b65ca225d06f52f72ac3c4b997ec4a",
  "workers_dev": true,
  "preview_urls": false,
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRACKER",
        "class_name": "Tracker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Tracker"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "linc-files",
    },
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "kazumasa.cloudflareaccess.com",
    "ACCESS_AUD": "d08672bb6f754c9f732e0da80a5acb412e98d3832ab4b33b393234872faa4942",
    "BOOTSTRAP_OWNER_EMAIL": "kazumasa@gmail.com",
  },
}
